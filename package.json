{
  "name": "schoolnode",
  "version": "1.0.0",
  "description": "Sistema de gestión escolar para automatización de matrículas y control financiero",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "start:prod": "NODE_ENV=production node src/app.js",
    "seed": "node src/seeds/seed.js",
    "arreglar-saldos": "node src/seeds/arreglar-saldos.js",
    "test": "node --test \"tests/*.test.js\"",
    "check:frontend": "node scripts/verificar-frontend.js",
    "check:correos": "node scripts/verificar-correos.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "education",
    "management",
    "stripe",
    "mongodb"
  ],
  "author": "Daniel Felipe Serna López",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.0",
    "stripe": "^16.2.0",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
