<!-- Sidebar parcial reutilizable -->
<nav class="bg-light sidebar" id="sidebar">
  <button type="button" class="sidebar-cerrar" id="sidebarCerrar" aria-label="Cerrar menú">×</button>
  <div class="position-sticky pt-3">
    <div class="text-center mb-4">
      <div class="bg-primary text-white p-3 rounded mb-2 d-flex align-items-center justify-content-center" id="sidebarLogo" style="width: 80px; height: 80px; margin: 0 auto;">
        <span id="sidebarLogoIcon" style="font-size: 2.5rem;">🏫</span>
      </div>
    </div>
    <ul class="nav flex-column">
      <% if (typeof esAdmin !== 'undefined' && esAdmin === true) { %>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>" href="/dashboard">
          Dashboard
        </a>
      </li>
      <% } %>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Estudiantes' ? 'active' : '' %>" href="/estudiantes">
          Estudiantes
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Cursos' ? 'active' : '' %>" href="/cursos">
          Cursos
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Matrículas' ? 'active' : '' %>" href="/matriculas">
          Matrículas
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Pagos' ? 'active' : '' %>" href="/pagos">
          Pagos
        </a>
      </li>
      <% if (typeof esAdmin !== 'undefined' && esAdmin === true) { %>
      <li class="nav-item">
        <a class="nav-link <%= title === 'Empleados' ? 'active' : '' %>" href="/empleados">
          Empleados
        </a>
      </li>
      <% } %>
      <li class="nav-item mt-auto"></li>
    </ul>
    <!-- Botones inferiores: Ayuda visible para todos, Ajustes solo admin, Cerrar Sesión para todos -->
    <div class="sidebar-bottom">
      <div class="row g-0 mb-1">
        <div class="col-6 pe-0">
          <a class="btn btn-light w-100" href="/ayuda">Ayuda</a>
        </div>
        <% if (typeof esAdmin !== 'undefined' && esAdmin === true) { %>
        <div class="col-6 ps-0">
          <a class="btn btn-light w-100" href="/ajustes">Ajustes</a>
        </div>
        <% } else { %>
        <div class="col-6 ps-0">
          <a class="btn btn-light w-100 disabled" aria-disabled="true" title="Solo administradores">Ajustes</a>
        </div>
        <% } %>
      </div>
      <a class="btn btn-danger w-100" href="/api/auth/logout">Cerrar Sesión</a>
    </div>
  </div>
</nav>

<!-- Overlay para cerrar el menú en móvil/tablet -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<script>
  // Toggle del sidebar off-canvas en móvil/tablet
  (function () {
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('sidebarOverlay');
    var btnCerrar = document.getElementById('sidebarCerrar');

    function abrirSidebar() {
      sidebar.classList.add('show');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function cerrarSidebar() {
      sidebar.classList.remove('show');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    overlay.addEventListener('click', cerrarSidebar);
    btnCerrar.addEventListener('click', cerrarSidebar);

    // El botón hamburguesa está en el header (se renderiza después del sidebar)
    document.addEventListener('DOMContentLoaded', function () {
      var btnMenu = document.getElementById('btnMenu');
      if (btnMenu) {
        btnMenu.addEventListener('click', abrirSidebar);
      }
    });

    // Cerrar el menú al pulsar un enlace en móvil/tablet
    sidebar.querySelectorAll('a[href]').forEach(function (enlace) {
      enlace.addEventListener('click', function () {
        if (window.innerWidth < 992) cerrarSidebar();
      });
    });

    // Cerrar el menú si se redimensiona a desktop
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 992) cerrarSidebar();
    });
  })();
</script>
