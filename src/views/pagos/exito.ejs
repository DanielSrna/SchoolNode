<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pago Exitoso - SchoolNode</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-light">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
      <div class="col-11 col-sm-8 col-md-6 col-lg-5">
        <div class="card shadow">
          <div class="card-header bg-success text-white text-center">
            <h4 class="mb-0">✓ Pago Procesado</h4>
          </div>
          <div class="card-body p-4 text-center">
            <div style="font-size: 4rem;">✅</div>
            <h5 class="mb-3">El pago se completó exitosamente</h5>
            <div id="detalleMatricula" class="mb-3">
              <p class="text-muted">Stripe está confirmando la transacción...</p>
            </div>
            <div class="d-grid gap-2">
              <a href="/pagos" class="btn btn-primary">Ir a Pagos</a>
              <a href="/matriculas" class="btn btn-outline-secondary">Ver Matrículas</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Si la URL trae el id de la matrícula, mostrar su estado actualizado
    const params = new URLSearchParams(window.location.search);
    const matriculaId = params.get('matricula');

    if (matriculaId) {
      fetch(`/api/matriculas/${matriculaId}`)
        .then((res) => (res.ok ? res.json() : null))
        .then((mat) => {
          if (!mat) return;
          document.getElementById('detalleMatricula').innerHTML = `
            <hr>
            <p class="mb-1"><strong>${mat.estudiante.nombre} ${mat.estudiante.apellido}</strong></p>
            <p class="mb-1">${mat.curso.nombre}</p>
            <p class="mb-0">
              Pagado: <strong class="text-success">$${mat.totalPagado.toLocaleString('es-CO')}</strong>
              &nbsp;|&nbsp;
              Saldo: <strong class="${mat.saldoPendiente > 0 ? 'text-danger' : 'text-success'}">
                $${mat.saldoPendiente.toLocaleString('es-CO')}
              </strong>
            </p>
            <small class="text-muted">Estado: ${mat.estado.toUpperCase()}</small>
          `;
        })
        .catch(() => {});
    }
  </script>
</body>
</html>
