<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Dashboard' %> - SchoolNode</title>
  <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <%- include('partials/sidebar') %>

      <main>
        <%- include('partials/header') %>

        <h2 class="mb-4">Gestión general del sistema</h2>

        <!-- Stats Cards -->
        <div class="row mb-4 g-2 g-md-3">
          <div class="col-6 col-lg-3">
            <div class="card text-bg-primary">
              <div class="card-body">
                <h5 class="card-title">Estudiantes</h5>
                <p class="card-text display-6" id="totalEstudiantes">-</p>
              </div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="card text-bg-success">
              <div class="card-body">
                <h5 class="card-title">Matrículas Activas</h5>
                <p class="card-text display-6" id="matriculasActivas">-</p>
              </div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="card text-bg-warning">
              <div class="card-body">
                <h5 class="card-title">Ingresos Totales</h5>
                <p class="card-text display-6" id="ingresosTotales">-</p>
              </div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="card text-bg-danger">
              <div class="card-body">
                <h5 class="card-title">Morosos</h5>
                <p class="card-text display-6" id="totalMorosos">-</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Resumen del Sistema -->
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Resumen del Sistema</h5>
          </div>
          <div class="card-body">
            <p>Bienvenido al sistema de gestión escolar SchoolNode.</p>
            <p>Este panel centraliza la operación administrativa y financiera del centro de enseñanza:</p>
            <ul>
              <li>Gestión completa de estudiantes, cursos, aulas y matrículas</li>
              <li>Control de capacidad de aulas y semaforización de matrículas por vencimiento</li>
              <li>Registro de pagos físicos y en línea con pasarela de pagos</li>
              <li>Generación de facturas PDF y conciliación automática de saldos</li>
              <li>Acceso seguro con autenticación JWT y control por roles</li>
            </ul>
            <% if (typeof mostrarCredenciales !== 'undefined' && mostrarCredenciales) { %>
            <div class="alert alert-info mt-4">
              <strong>Credenciales de prueba:</strong><br>
              Admin: admin@schoolnode.com / Admin123!<br>
              Empleado: empleado1@schoolnode.com / Empleado123!
            </div>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="/vendor/bootstrap/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/usuario.js"></script>
</body>
</html>
