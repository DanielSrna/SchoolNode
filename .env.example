# Entorno
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/schoolnode?retryWrites=true&w=majority

# JWT
JWT_SECRET=tu_secreto_super_secreto_para_access_tokens
JWT_REFRESH_SECRET=tu_secreto_super_secreto_para_refresh_tokens
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_de_webhook

# URL de la aplicación (para callbacks de Stripe)
APP_URL=http://localhost:3000

# Correo (Gmail SMTP) - Para verificación de cambios de credenciales
# Usar una "contraseña de aplicación" de Google, NO la contraseña normal:
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion

# Rate limiting (por IP, ventana de 15 minutos)
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
